# Orcastra never enables live orders from this file. The only supported mode in
# the initial scaffold is paper trading.
ORCASTRA_EXECUTION_MODE=paper
ORCASTRA_ARTIFACTS_DIR=artifacts

# Add provider credentials only to a local .env file. Never commit or persist
# them in traces. The mock runner does not require any credentials.
# OPENAI_API_KEY=
# TOSSINVEST_CLIENT_ID=
# TOSSINVEST_CLIENT_SECRET=

